{
  "name": "senoro_green_farm",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy:android": "npx nuxi generate && npx cap sync android && npx cap run android",
    "generate:assets": "capacitor-assets generate --assetPath assets --iconBackgroundColor #2F5D3A --splashBackgroundColor #2F5D3A",
    "deploy:ios": "nuxi generate && @capacitor/assets generate && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.4.0",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/vue": "^8.8.8",
    "@nuxt/icon": "^2.2.2",
    "@nuxtjs/supabase": "^2.0.9",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "highcharts": "^12.6.0",
    "ionicons": "^8.0.13",
    "leaflet": "^1.9.4",
    "nuxt": "^4.4.6",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.5"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "esbuild@0.27.7": true
  }
}
